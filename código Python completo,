import random


# ==========================================
# BUBBLE SORT
# ==========================================

def bubble_sort(lista):

    comparacoes = 0
    trocas = 0

    for i in range(len(lista) - 1):

        for j in range(len(lista) - 1 - i):

            comparacoes += 1

            if lista[j] > lista[j + 1]:

                aux = lista[j]
                lista[j] = lista[j + 1]
                lista[j + 1] = aux

                trocas += 1

    return comparacoes, trocas


# ==========================================
# QUICK SORT
# ==========================================

def quick_sort(lista, inicio, fim, contador):

    if inicio < fim:

        pivo = lista[fim]

        i = inicio - 1

        for j in range(inicio, fim):

            contador[0] += 1

            if lista[j] <= pivo:

                i += 1

                if i != j:

                    aux = lista[i]
                    lista[i] = lista[j]
                    lista[j] = aux

                    contador[1] += 1

        if i + 1 != fim:

            aux = lista[i + 1]
            lista[i + 1] = lista[fim]
            lista[fim] = aux

            contador[1] += 1

        posicao = i + 1

        quick_sort(lista, inicio, posicao - 1, contador)
        quick_sort(lista, posicao + 1, fim, contador)


