# ==========================================
# PARTE 3
# BUSCA EM MATRIZES
# ==========================================

print("\n")
print("=" * 60)
print("BUSCA SEQUENCIAL EM MATRIZES")
print("=" * 60)


def criar_matriz(linhas, colunas):

    matriz = []

    numero = 1

    for i in range(linhas):

        linha = []

        for j in range(colunas):

            linha.append(numero)
            numero += 1

        matriz.append(linha)

    return matriz


def buscar(matriz, valor):

    comparacoes = 0

    for i in range(len(matriz)):

        for j in range(len(matriz[i])):

            comparacoes += 1

            if matriz[i][j] == valor:

                return comparacoes, i, j

    return comparacoes, -1, -1


# Matrizes utilizadas
tamanhos_matrizes = [
    (2, 2),
    (10, 10),
    (100, 100)
]


for linhas, colunas in tamanhos_matrizes:

    matriz = criar_matriz(linhas, colunas)

    quantidade = linhas * colunas

    # Busca no início
    valor_inicio = matriz[0][0]

    comparacoes_inicio, linha, coluna = buscar(
        matriz,
        valor_inicio
    )

    # Busca no final
    valor_final = matriz[linhas - 1][colunas - 1]

    comparacoes_final, linha, coluna = buscar(
        matriz,
        valor_final
    )

    # Valor que não existe
    valor_inexistente = quantidade + 1

    comparacoes_inexistente, linha, coluna = buscar(
        matriz,
        valor_inexistente
    )

    print("\nMatriz:", linhas, "x", colunas)
    print("Quantidade de elementos:", quantidade)

    print(
        "Busca no início:",
        comparacoes_inicio,
        "comparações"
    )

    print(
        "Busca no final:",
        comparacoes_final,
        "comparações"
    )

    print(
        "Valor inexistente:",
        comparacoes_inexistente,
        "comparações"
    )


